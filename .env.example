# ==============================================================================
# IncuBrix Lead Discovery & Qualification Engine - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# YouTube Data API v3 Key (Optional for live YouTube creator discovery)
# Leave empty if using CSV imports only. Do NOT commit real API keys to git.
YOUTUBE_API_KEY=

# SQLite Database Location
DATABASE_PATH=data/database/leads.db

# Path to Qualification Configuration JSON
CONFIG_PATH=config/qualification_config.json

# Directories
INPUT_DIR=data/input
OUTPUT_DIR=data/output

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=data/app.log

# Safe Seed Testing & Outreach Simulator (Test Mode Only)
TEST_BASE_URL=http://localhost:8501
SIMULATOR_PORT=8502
CANDIDATE_TEST_ACCOUNT=growth.engineer.candidate@gmail.com

# Outbound Sender Identity (production deployment override)
# SENDER_IDENTITY="IncuBrix Creator Partnerships Team"
